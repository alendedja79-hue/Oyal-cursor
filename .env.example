# Oyal environment configuration
#
# Copy this file to `.env` and fill in your values. All variables are prefixed
# with EXPO_PUBLIC_ so Expo inlines them into the client bundle.
#
# Leave the Supabase values blank to run Oyal in local DEMO MODE, which uses a
# fully-featured on-device mock backend (seeded with sample trips + forum posts)
# so the app is runnable and testable without any cloud setup.

# --- Supabase (hosted DB, auth, media storage) ---
# Create a project at https://supabase.com, run `supabase/schema.sql`, then paste:
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Google OAuth (optional) ---
# Configure the Google provider in Supabase Auth, then add the client id here.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# --- Geocoder for location tagging (optional) ---
# Defaults to the free OpenStreetMap Nominatim service. Override to use a
# self-hosted Nominatim or a compatible geocoding proxy.
EXPO_PUBLIC_GEOCODER_URL=https://nominatim.openstreetmap.org
